+  // （iOS Safari 一張 canvas 的上限 16,777,216，留一點）
+  const MV_GROUND_RASTER = typeof location !== "undefined" && /[?&]ground=raster(?:&|$)/.test(String(location.search || ""));
+  const GROUND_PX_MAX = 16e6;
+  function groundBakeScale(base, k) {
