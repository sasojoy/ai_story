          {"text": "放手一搏（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      },
      {
        "id": "changshe_2",
        "title": "夜風將起",
        "text": "入夜之後，風從草澤上吹過來，越吹越緊。城上忽然靜了下來；黃巾營裡有人抬頭看天，也有人照舊圍著火堆取暖。",
        "goal": "搶在天亮之前佔到上風",
        "options": [
          {"text": "按兵不動，靜待時機", "tag": "guan_safe", "faction": "guan"},
          {"text": "縋城而下，襲擾敵營", "tag": "guan_aggressive", "faction": "guan"},
          {"text": "孤注一擲（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "收攏營寨，嚴加戒備", "tag": "huang_safe", "faction": "huang"},
          {"text": "趁夜摸上城頭", "tag": "huang_aggressive", "faction": "huang"},
