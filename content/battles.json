    "acts": [
      {
        "id": "showdown_1",
        "title": "兩軍對陣",
        "text": "官軍與黃巾軍主力在潁川城外列陣，旌旗蔽日，殺氣騰騰——決定中原命運的一戰，就在今日。",
        "goal": "推動戰局，別讓對方先拉開差距",
        "text_by_lead": {"guan": "官軍陣列嚴整，前鋒已經壓到黃巾營前；黃巾的旗陣往後縮，鼓聲卻越敲越急。", "huang": "黃巾漫山遍野地湧上來，官軍前排被擠得步步後退，喊聲蓋過了號角。"},
        "options": [
          {"text": "率先衝鋒", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "穩守陣線", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "分兵繞到敵陣側後", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "放手一搏（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "捨命衝殺", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "死守營寨", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "暗遣人馬，抄截官軍輜重", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "放手一搏（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      },
      {
        "id": "showdown_2",
        "title": "鏖戰正酣",
        "text": "戰線犬牙交錯，雙方都已殺紅了眼，誰能撐到最後，誰就能主宰接下來的戰局。",
        "goal": "持續推動戰局，撐過這一輪消耗",
        "text_by_lead": {"guan": "官軍的陣線一寸寸往前推，黃巾的隊伍被切成好幾段，各自死戰。", "huang": "黃巾從四面八方纏住官軍，官軍的陣腳亂了，只能邊打邊收攏。"},
        "options": [
          {"text": "全線壓上，猛攻不歇", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "穩紮穩打，徐圖進取", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "輕騎迂迴，直插敵後", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "孤注一擲（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "拼死反撲，誓死不退", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "且戰且退，保存實力", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "埋伏林中，截殺追兵", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "孤注一擲（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      },
      {
        "id": "showdown_3",
        "title": "決勝時刻",
        "text": "勝負已經近在咫尺，這最後一擊，將決定誰才是潁川城下真正的主人。",
        "goal": "分出最終勝負",
        "text_by_lead": {"guan": "黃巾的大旗已經在搖晃，官軍只差最後一口氣。", "huang": "官軍的陣線快要撐不住了，黃巾只差最後一口氣。"},
        "options": [
          {"text": "全軍壓上，畢其功於一役", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "穩住陣腳，等待戰機", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "趁亂直取敵軍大旗", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "背水一戰（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "絕地反擊，背水一戰", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "死守最後防線", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "放火燒營，亂中奪路", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "背水一戰（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      }
    ],
    "outcomes": [
      {
        "faction": "guan",
        "trend_min": 65,
        "title": "官軍大勝",
        "text": "官軍士氣如虹，黃巾軍全線潰散，波才的主力在這一戰中土崩瓦解——潁川的危局，就此解除大半。",
        "world_flags_add": ["huangjin_decisive_win"],
        "trend_delta": {"yingru": -35}
      },
      {
        "faction": "huang",
        "trend_max": 35,
        "title": "黃巾得勢",
        "text": "黃巾軍殺出重圍，官軍損兵折將，潁川城下一片狼藉——波才的聲勢，反而因此更加浩大。",
        "world_flags_add": ["huangjin_decisive_loss"],
        "trend_delta": {"yingru": 25}
      },
      {
        "faction": "guan",
        "title": "兩軍膠著",
        "text": "鏖戰半日，雙方都已疲憊不堪，各自鳴金收兵——這一戰沒能分出勝負，但官軍總算守住了陣線。",
        "world_flags_add": [],
        "trend_delta": {"yingru": -5}
      }
    ]
  },
