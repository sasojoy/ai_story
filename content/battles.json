    "acts": [
      {
        "id": "changshe_1",
        "title": "長社被圍",
        "text": "黃巾數萬人依著長社城外的草澤結營，把城圍得水洩不通。城裡的官軍兵少，守了多日，城頭的旗卻一面也沒倒。",
        "goal": "撐過圍城的頭一陣，別讓對方先拉開差距",
        "text_by_lead": {"guan": "城頭的箭一陣比一陣密，黃巾的雲梯靠不上牆，前營往後撤了幾里。", "huang": "黃巾的營圍著長社一圈圈收緊，城上的守兵越來越少，旗卻還立著。"},
        "options": [
          {"text": "開門突擊黃巾前營", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "固守城頭", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "縋城而下，夜探敵營虛實", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "放手一搏（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "架起雲梯，強攻城牆", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "圍住四門，斷絕城中糧道", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "挖掘地道，潛向城根", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "放手一搏（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      },
      {
        "id": "changshe_2",
        "title": "夜風將起",
        "text": "入夜之後，風從草澤上吹過來，越吹越緊。城上忽然靜了下來；黃巾營裡有人抬頭看天，也有人照舊圍著火堆取暖。",
        "goal": "搶在天亮之前佔到上風",
        "text_by_lead": {"guan": "入夜之後，官軍守得從容，黃巾在城下吃了幾次虧，營裡吵吵嚷嚷。", "huang": "入夜之後，黃巾已經摸到城根，城上的守兵輪班不及，喊聲此起彼落。"},
        "options": [
          {"text": "點齊兵馬，出城衝營", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "按兵不動，靜待時機", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "縋城而下，襲擾敵營", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "孤注一擲（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "趁夜猛攻城門", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "收攏營寨，嚴加戒備", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "趁夜摸上城頭", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "孤注一擲（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      },
      {
        "id": "changshe_3",
        "title": "決勝長社",
        "text": "草澤裡、城頭上，到處是火把與喊殺聲。天一亮，長社城下還站著的那一方，就是潁川的主人。",
        "goal": "分出最終勝負",
        "text_by_lead": {"guan": "天快亮了，城下的黃巾一隊隊潰退，長社的城門還牢牢關著。", "huang": "天快亮了，黃巾已經湧到城門下，城頭的官軍只剩最後幾隊。"},
        "options": [
          {"text": "全軍出城，衝擊敵陣", "tag": "guan_strong", "faction": "guan", "move": "強攻"},
          {"text": "守住城門，穩住陣腳", "tag": "guan_hold", "faction": "guan", "move": "固守"},
          {"text": "分兵出側門，抄敵後路", "tag": "guan_raid", "faction": "guan", "move": "奇襲"},
          {"text": "背水一戰（20字內，寫下你想做的事）", "tag": "guan_reckless", "faction": "guan", "free_text": true},
          {"text": "全軍壓上，奪下城門", "tag": "huang_strong", "faction": "huang", "move": "強攻"},
          {"text": "穩住營盤，步步進逼", "tag": "huang_hold", "faction": "huang", "move": "固守"},
          {"text": "繞到城北，偷開小門", "tag": "huang_raid", "faction": "huang", "move": "奇襲"},
          {"text": "背水一戰（20字內，寫下你想做的事）", "tag": "huang_reckless", "faction": "huang", "free_text": true}
        ]
      }
    ],
