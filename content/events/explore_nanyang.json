[
  {
    "id": "ny_wan_stonelock",
    "title": "校場石鎖",
    "locations": [
      "wan_city"
    ],
    "text": "宛城郡府外的校場上，募兵的軍吏擺出一排石鎖，誰舉得過頭就能領一份賞錢。人群裡議論紛紛，說朱將軍麾下有個江東來的少年校尉，就是這樣一路打出名號的。",
    "choices": [
      {
        "text": "挑最重的那對石鎖",
        "check": {
          "stat": "str",
          "difficulty": 7
        },
        "effect": {
          "text": "你把石鎖穩穩舉過頭頂，校場上一片喝采。軍吏記下你的名號，多給了一串錢。",
          "stats": {
            "silver": 25,
            "fame": 2
          },
          "trend": {
            "huangjin": -1
          }
        },
        "fail_effect": {
          "text": "石鎖舉到胸口就再也上不去，砸在腳邊揚起一片塵土，旁人哄笑一陣。",
          "stamina": -10,
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "挑輕一號的舉",
        "check": {
          "stat": "str",
          "difficulty": 5
        },
        "effect": {
          "text": "輕的那對你舉得輕鬆，軍吏點點頭，丟給你幾枚錢。",
          "stats": {
            "silver": 10
          }
        },
        "fail_effect": {
          "text": "連輕的都晃了兩晃才放下，軍吏擺擺手要你下一位。",
          "stamina": -5
        }
      },
      {
        "text": "跟老兵比扛沙囊繞校場",
        "check": {
          "stat": "con",
          "difficulty": 7,
          "by": "self"
        },
        "effect": {
          "text": "你扛著沙囊走完十圈，老兵先撐不住坐倒在地，拍著你肩膀說這才是能熬長仗的身子。",
          "stats": {
            "xinde": 10,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "走到第六圈你眼前發黑，沙囊落地，被人扶到樹蔭下灌了半瓢水。",
          "stamina": -15
        }
      },
      {
        "text": "站在場邊看熱鬧",
        "effect": {
          "text": "你看了半晌，聽人把那江東校尉的事蹟又添油加醋說了三遍。"
        }
      }
    ]
  },
  {
    "id": "ny_wan_gatecheck",
    "title": "城門盤查",
    "locations": [
      "wan_city"
    ],
    "text": "宛城南門的守卒正盤查進城的鄉民，一個販棗的老漢被扣下，籮筐底翻出一塊黃布。老漢跪著直喊冤，說那是他孫女的頭巾，守卒已經抽出了繩索。",
    "choices": [
      {
        "text": "細看那塊黃布",
        "check": {
          "stat": "wis",
          "difficulty": 6
        },
        "effect": {
          "text": "你指出布邊繡著小花，是女兒家的針線，不是黃巾的頭巾。守卒悻悻放人，老漢塞給你一把乾棗。",
          "stats": {
            "good": 2,
            "silver": 5
          }
        },
        "fail_effect": {
          "text": "你說了半天也說不出所以然，守卒嫌你囉嗦，連你的行囊也翻了一遍。",
          "stamina": -5,
          "stats": {
            "silver": -5
          }
        }
      },
      {
        "text": "替老漢擔保，任守卒罰你",
        "check": {
          "stat": "con",
          "difficulty": 6,
          "by": "self"
        },
        "effect": {
          "text": "你挨了守卒兩記藤條，一聲沒吭。守卒反倒不好意思，揮手讓你們都過去。",
          "stats": {
            "good": 2,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "兩記藤條下來你疼得叫出聲，守卒冷笑說擔保也得有骨頭，罰了你一筆錢才放人。",
          "stats": {
            "silver": -15
          }
        }
      },
      {
        "text": "塞錢給守卒了事",
        "effect": {
          "text": "十來枚錢遞過去，守卒把繩索收了回去。老漢千恩萬謝，挑著擔子進了城。",
          "stats": {
            "silver": -10,
            "good": 1
          }
        }
      },
      {
        "text": "不關你的事，排隊進城",
        "effect": {
          "text": "你從旁邊走過，身後老漢的哭喊聲越來越遠。"
        }
      }
    ]
  },
  {
    "id": "ny_road_well",
    "title": "焚村枯井",
    "locations": [
      "nanyang_road"
    ],
    "text": "官道旁一座燒剩半邊的村子，屋梁還冒著青煙。村口井裡傳出微弱的呼救聲，探頭一看，井底泡著一個婦人，懷裡緊抱著孩子，水已經淹到她胸口。",
    "choices": [
      {
        "text": "綁上繩子親自下井",
        "check": {
          "stat": "con",
          "difficulty": 7,
          "by": "self"
        },
        "effect": {
          "text": "井水冰得刺骨，你撐著井壁把母子一個一個托上去。婦人說黃巾散兵來時，她只來得及躲進井裡。",
          "stats": {
            "good": 3,
            "xinde": 8
          }
        },
        "fail_effect": {
          "text": "你在井底凍得手腳發僵，最後是母子倆合力把你拉上來的。",
          "stamina": -15
        }
      },
      {
        "text": "在井口把人拉上來",
        "check": {
          "stat": "str",
          "difficulty": 6
        },
        "effect": {
          "text": "你一把一把收著繩子，把母子拉出井口。婦人癱在地上，半天才哭出聲來。",
          "stats": {
            "good": 2
          }
        },
        "fail_effect": {
          "text": "繩子在你手裡一滑，人又落回水裡，折騰了半天才救上來，你的手掌磨得血肉模糊。",
          "stamina": -10,
          "stats": {
            "good": 1
          }
        }
      },
      {
        "text": "去找附近的人來幫忙",
        "effect": {
          "text": "你在村外找到兩個躲在田溝裡的村民，一起把人救了上來。",
          "stamina": -5,
          "stats": {
            "good": 1
          }
        }
      }
    ]
  },
  {
    "id": "ny_road_brokencart",
    "title": "斷軸牛車",
    "locations": [
      "nanyang_road"
    ],
    "text": "一隊逃難的人家停在官道上，領頭的牛車車軸斷了，箱籠撒了一地。後方坡頂冒出幾個纏黃巾的散兵，正指指點點往這邊走來。",
    "choices": [
      {
        "text": "迎上去攔住散兵",
        "combat": "shanzei",
        "effect": {
          "text": "散兵被你打得丟下刀槍逃回坡後。逃難的人家趁機把箱籠搬上別的車，向你作揖道謝。",
          "stats": {
            "good": 2,
            "fame": 1
          },
          "trend": {
            "huangjin": -1
          }
        },
        "fail_effect": {
          "text": "散兵人多，你被逼退到路旁，眼看他們搶走了兩口箱子揚長而去。",
          "stamina": -15,
          "stats": {
