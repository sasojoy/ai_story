[
  {
    "id": "sc_zhuo_mortar",
    "title": "募兵石臼",
    "actions": [
      "socialize"
    ],
    "locations": [
      "zhuo_county"
    ],
    "text": "縣寺外貼著募鄉勇的告示，識字的人少，一群少年擠著瞎猜。一個斷了兩指的老卒在旁擺了個舂米石臼，說誰舉得過頭，他就替誰在名簿上說句好話。",
    "choices": [
      {
        "text": "挽起袖子去舉石臼",
        "check": {
          "stat": "str",
          "difficulty": 4,
          "by": "self"
        },
        "effect": {
          "text": "你一聲低喝把石臼舉過頭頂，少年們轟然叫好。老卒拍你肩膀，說涿郡這回總算有幾條漢子。",
          "stats": {
            "fame": 2,
            "xinde": 4
          }
        },
        "fail_effect": {
          "text": "石臼離地半尺就滑了手，砸在腳邊，你扭了腰，在旁人的笑聲裡揉了半天。",
          "stamina": -10
        }
      },
      {
        "text": "替大夥念告示、講明條目",
        "check": {
          "stat": "wis",
          "difficulty": 3
        },
        "effect": {
          "text": "你一條條講清楚：自備兵器者每月多給糧多少，傷殘者如何撫恤。少年們聽得明白，好幾家父兄來向你道謝。",
          "stats": {
            "good": 2,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "你把「自備」念成了「官給」，一個少年當真回家把柴刀扔了，回頭找你理論，你只好賠他二十錢買把新的。",
          "stats": {
            "silver": -20
          }
        }
      },
      {
        "text": "在一旁看熱鬧",
        "effect": {
          "text": "少年們輪番上陣，舉起來的沒幾個。老卒嘆氣，說幽州的糧比人還難湊。"
        }
      }
    ]
  },
