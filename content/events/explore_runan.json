  {
    "id": "rn_ac_qingyi",
    "title": "黨錮初解",
    "locations": [
      "runan_academy"
    ],
    "text": "朝廷為了對付黃巾，解除了關了十幾年的黨錮。學宮講堂裡擠得水洩不通，一派說該乘勢清算宦官，一派說兵荒馬亂先求安定，吵得面紅耳赤。",
    "choices": [
      {
        "text": "起身陳說自己的看法",
        "check": {
          "stat": "wis",
          "difficulty": 7,
          "by": "self"
        },
        "effect": {
          "text": "你引經據典說了一番，兩派都有人點頭。散會後還有士人追出來，跟你約日再談。",
          "stats": {
            "fame": 2,
            "xinde": 6
          }
        },
        "fail_effect": {
          "text": "你話說到一半就被人駁倒，堂上一片噓聲，你訕訕坐下。",
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "連夜把兩派的議論抄錄下來",
        "check": {
          "stat": "con",
          "difficulty": 5,
          "by": "self"
        },
        "effect": {
          "text": "你點著油燈抄到雞鳴，把一天的議論記得一字不漏，抄著抄著也想通了不少事。",
          "stats": {
            "xinde": 10
          },
          "stamina": -10
        },
        "fail_effect": {
          "text": "抄到三更你就趴在案上睡著了，燈油打翻，半卷都汙了。",
          "stamina": -10
        }
      },
      {
        "text": "坐在角落聽",
        "effect": {
          "text": "聽到後來，你發現兩派爭的其實是誰來當這個太守。",
          "stats": {
            "xinde": 3
          }
        }
      }
    ]
  },
