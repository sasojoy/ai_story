[
  {
    "id": "rn_yuedan",
    "title": "月旦品評",
    "locations": [
      "runan"
    ],
    "text": "每月初一，汝南名士聚在里中品評鄉里人物，一句評語能定一個人半生的名聲。今日席外擠滿了投刺的年輕人，門生正一個個唱名，輪到誰才許進去答話。",
    "choices": [
      {
        "text": "進席應對，聽憑品評",
        "check": {
          "stat": "wis",
          "difficulty": 7,
          "by": "self"
        },
        "effect": {
          "text": "你答得不卑不亢，席上一位老名士點頭，說你「器識可觀」。這四個字當天就在里巷間傳開了。",
          "stats": {
            "fame": 2
          }
        },
        "fail_effect": {
          "text": "你一緊張答非所問，席間有人掩口而笑，評語只得「浮躁」二字。",
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "替門生搬酒甕、在席外站一整天",
        "check": {
          "stat": "con",
          "difficulty": 5,
          "by": "self"
        },
        "effect": {
          "text": "你從清晨站到日落，耳朵沒閒著，席間議論的天下事聽了一肚子。",
          "stats": {
            "xinde": 6
          },
          "stamina": -10
        },
        "fail_effect": {
          "text": "日頭毒，你站到午後就頭暈眼花，被人扶到樹下歇著，什麼也沒聽到。",
          "stamina": -10
        }
      },
      {
        "text": "遠遠聽一會兒就走",
        "effect": {
          "text": "隔著人牆只聽見幾句「某某才堪治郡」，大家紛紛記在心上。",
          "stats": {
            "xinde": 2
          }
        }
      }
    ]
  },
  {
    "id": "rn_yuan_slips",
    "title": "袁府簡牘",
    "locations": [
      "runan"
    ],
    "text": "袁氏府門前車馬不斷，四世三公的門第，連看門的蒼頭都比縣吏體面。府裡一位老管事要找人把幾擔舊簡牘挑去城東別業，嫌家奴手腳粗笨，在門口挑人。",
    "choices": [
      {
        "text": "挑起擔子，一口氣走到城東",
        "check": {
          "stat": "con",
          "difficulty": 6
        },
        "effect": {
          "text": "一擔竹簡沉得像石頭，你一路沒歇腳。老管事點清了數目，多賞了你一串錢。",
          "stats": {
            "silver": 20
          },
          "stamina": -10
