[
  {
    "id": "sc_rn_feast",
    "title": "袁門故吏宴",
    "actions": [
      "socialize"
    ],
    "locations": [
      "runan"
    ],
    "text": "袁氏一位門生故吏升了郡吏，在城東宅中大宴賓客，堂下擺滿酒甕。座中多是受過袁家提攜的人，酒過三巡，主人舉爵要與新客一一對飲。",
    "choices": [
      {
        "text": "舉爵奉陪，一爵接一爵",
        "check": {
          "stat": "con",
          "difficulty": 4,
          "by": "self"
        },
        "effect": {
          "text": "你連飲十餘爵面不改色，主人拍案稱快，當席把你引見給幾位郡中掾吏，臨別還贈了一份程儀。",
          "stats": {
            "fame": 2,
            "silver": 15
          },
          "rumor": "聽說汝南袁氏故吏設宴，有個叫{name}的外客連飲十餘爵不倒，滿座側目。"
        },
        "fail_effect": {
          "text": "幾爵下肚你便天旋地轉，伏在案上睡到宴散，被僕役扶出門外，頭痛了大半天。",
          "stamina": -15,
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "以酒為題，即席作一段頌辭",
        "check": {
          "stat": "wis",
          "difficulty": 5
        },
        "effect": {
          "text": "你從袁氏累世公卿說到主人新任，辭句得體，座中老吏頻頻點頭，有人私下約你改日論學。",
          "stats": {
            "fame": 1,
            "xinde": 8
          }
        },
        "fail_effect": {
          "text": "你一時詞窮，頌辭說得顛三倒四，鄰座的士人掩口而笑。",
          "stats": {
            "fame": -2
          }
        }
      },
      {
        "text": "只淺酌一爵，靜聽席間議論",
        "effect": {
          "text": "你聽了一席郡中人事，誰得袁家青眼、誰被冷落，心裡多少有了數。",
          "stats": {
            "xinde": 3
          }
        }
      }
    ]
