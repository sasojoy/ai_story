[
  {
    "id": "jizhou_altar_oath",
    "title": "壇前立誓",
    "locations": [
      "julu_altar"
    ],
    "text": "壇前跪著一排新入道的人，輪流對著香爐立誓。排在你前面的少年手抖得厲害，回頭小聲問你：「立了誓，是不是就回不了家了？」",
    "choices": [
      {
        "text": "告訴他黃天會護著他",
        "effect": {
          "text": "少年咬牙立了誓，道人替他在額上纏起黃巾。",
          "trend": {
            "front": 1
          }
        }
      },
      {
        "text": "趁亂把他拉出隊伍",
        "check": {
          "stat": "agi",
          "difficulty": 7
        },
        "effect": {
          "text": "你拉著少年鑽出人群，一路跑到壇外的麥田邊。他說家中還有老母，向你磕了個頭，往南去了。",
          "stats": {
            "good": 2
          }
        },
        "fail_effect": {
          "text": "壇前的力士一把揪住你們，少年被押回隊伍，你被推出了壇外。",
          "stamina": -10,
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "不作聲",
        "effect": {
          "text": "少年轉回頭去，香爐裡的煙燻得人睜不開眼。"
        }
      }
    ]
  },
  {
    "id": "jizhou_altar_sermon",
    "title": "夜半講經",
    "locations": [
      "julu_altar"
    ],
    "text": "入夜，道壇後的草棚裡點著油燈，一位黃衣道人向信眾講說「太平」二字：來日天下無飢，人人有田可耕。棚外守著幾個執杖的力士。",
    "choices": [
      {
        "text": "坐下細聽",
        "check": {
          "stat": "wis",
          "difficulty": 6,
          "by": "self"
        },
        "effect": {
          "text": "你聽出那些流離的人信的不是符水，是一口飯、一塊田。這一夜你想了很多。",
          "stats": {
            "wis": 1
          }
        },
        "fail_effect": {
          "text": "你聽得昏昏欲睡，被道人點名問話，答不上來，惹來一片白眼。"
        }
      },
      {
        "text": "起身質問他拿什麼讓人人有田",
        "combat": "taiping_lishi",
        "effect": {
          "text": "力士圍上來被你打退，你趁亂走出草棚。信眾們望著你，眼神又懼又疑。",
          "stats": {
            "fame": 1
          },
          "trend": {
            "front": -1
          }
        },
        "fail_effect": {
          "text": "力士把你架出草棚，丟在壇外的泥地上。",
          "stamina": -15
        }
      },
      {
        "text": "捐些錢添燈油",
        "condition": {
          "min_stats": {
            "silver": 10
          }
        },
        "effect": {
          "text": "道人向你稽首，說黃天記得每一個心誠的人。",
          "stats": {
            "silver": -10
          },
          "trend": {
            "front": 1
          }
        }
      }
    ]
  },
  {
    "id": "jizhou_guangzong_moat",
    "title": "壕溝之外",
    "locations": [
      "guangzong"
    ],
    "text": "廣宗城外的壕溝又深又闊，黃巾兵驅趕著民夫往營壘上挑土。監工的頭目看你閒著，揚鞭要你也去挑。",
    "choices": [
      {
        "text": "低頭挑土，暗中記下營壘的布置",
        "check": {
          "stat": "wis",
          "difficulty": 7
        },
        "effect": {
          "text": "一整天下來，你把城東幾座營壘的位置記了個大概，夜裡託人送去了城外的官軍營中。",
          "stamina": -10,
          "stats": {
            "fame": 1
          },
          "trend": {
            "front": -2
          }
        },
        "fail_effect": {
          "text": "監工看你東張西望，一鞭抽在你背上。",
          "stamina": -15
        }
      },
      {
        "text": "替咳得直不起腰的老民夫多挑幾擔",
        "effect": {
          "text": "你多挑了幾擔，老民夫總算靠著土堆歇了口氣，悄悄把半塊餅塞給你。",
          "stamina": -15,
          "stats": {
            "good": 2
          }
        }
      },
      {
        "text": "推開監工，衝出營壘",
        "combat": "huangjin_sishi",
        "effect": {
          "text": "追來的死士被你打倒在壕溝邊，你翻過土堆，消失在城外的蘆葦裡。",
          "stats": {
            "fame": 2
          },
          "trend": {
            "front": -1
          }
        },
        "fail_effect": {
          "text": "死士們把你按在溝底打了一頓，搜走了錢袋才放你走。",
          "stamina": -15,
          "stats": {
            "silver": -10
          }
        }
      }
    ]
  },
  {
    "id": "jizhou_luzhi_enlist",
    "title": "轅門投軍",
    "locations": [
      "luzhi_camp"
    ],
    "text": "盧植營的轅門外排著投軍的人，書吏一個個登記姓名籍貫。你前面那個漢子報不出籍貫，支支吾吾，旁邊的軍侯已經按住了刀柄。",
    "choices": [
      {
        "text": "替他作保",
        "check": {
          "stat": "wis",
          "difficulty": 5
        },
        "effect": {
          "text": "你說他村子被燒，連戶籍都沒了，一路逃到這裡。書吏寫下了名字，漢子紅著眼向你作揖。",
          "stats": {
            "good": 2,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "軍侯冷冷看你一眼：「你也報上籍貫來。」你們兩個都被轟出了轅門。",
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "提醒軍侯多盤問幾句",
        "effect": {
          "text": "漢子被帶去盤問，從他的包袱裡搜出一條黃布。軍侯朝你點了點頭。",
          "stats": {
            "fame": 1
          },
          "trend": {
            "front": -1
          }
        }
      },
      {
        "text": "不管閒事",
        "effect": {
          "text": "書吏喊了下一個名字。"
        }
      }
    ]
  },
  {
    "id": "jizhou_camp_archery",
    "title": "營中較射",
    "locations": [
      "luzhi_camp"
    ],
    "text": "北軍的士卒在營中空地較射，靶子立在百步之外。一個屯長見你看得認真，把弓遞過來：「射中一箭，賞你一頓酒肉錢。」",
    "choices": [
      {
        "text": "接弓試射",
        "check": {
          "stat": "agi",
          "difficulty": 6
        },
        "effect": {
          "text": "箭正中靶心，四周一陣喝采，屯長拍著你的肩膀把錢塞給你。",
          "stats": {
            "silver": 15,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "箭擦著靶邊飛了出去，士卒們笑得前仰後合。"
        }
      },
      {
        "text": "說射箭不算本事，要比就比拳腳",
        "combat": "beijun_wuzu",
        "effect": {
          "text": "你連勝三個士卒，屯長收起了笑臉，親手給你倒了一碗酒。",
          "stats": {
            "silver": 20,
            "fame": 2
          }
        },
        "fail_effect": {
          "text": "北軍的士卒個個是練家子，你被摔得渾身是土。",
          "stamina": -15,
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "推說自己不會射箭",
        "effect": {
          "text": "屯長聳聳肩，把弓遞給了下一個人。"
        }
      }
    ]
  },
