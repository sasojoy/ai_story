          },
          "trend": {
            "front": -2
          }
        },
        "fail_effect": {
          "text": "對方人多，你被打倒在官道上，漆筒也被奪走了，錢袋也在混亂中被摸了去。",
          "stamina": -15,
          "stats": {
            "silver": -10
