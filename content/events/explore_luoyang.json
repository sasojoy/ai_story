[
  {
    "id": "ly_road_checkpoint",
    "title": "哨卡盤查",
    "locations": [
      "luoyang_road"
    ],
    "text": "洛陽官道上設了木柵哨卡，戍卒說近來有黃巾細作混進京畿，凡無過所的一律扣在道旁草棚裡，等亭長天明來發落。棚裡已擠了十幾個行商，蚊蚋成群。",
    "choices": [
      {
        "text": "在草棚裡硬熬一夜，等亭長來",
        "check": {
          "stat": "con",
          "difficulty": 4,
          "by": "self"
        },
        "effect": {
          "text": "你在悶熱的草棚裡坐了一整夜，天亮亭長一看你的面相，揮手放行。同棚的行商佩服你沉得住氣，送你一小袋精鐵砂當見面禮。",
          "materials": {
            "gang_1": 1
          }
        },
        "fail_effect": {
          "text": "熬到後半夜你頭昏腦脹，跟戍卒頂了幾句嘴，被罰去搬了一早上的拒馬。",
          "stamina": -12
        }
      },
      {
        "text": "跟戍卒講明來歷，請他通融",
        "check": {
          "stat": "wis",
          "difficulty": 5
        },
        "effect": {
          "text": "你把來處去處說得條理分明，又點出哨卡西邊那條小路沒人看守。什長記下了，放你先走。",
          "stats": {
            "good": 1,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "你越解釋越像在編，什長乾脆把你的行囊翻了個底朝天，順手摸走幾枚錢。",
          "stats": {
            "silver": -15
          }
        }
      },
      {
        "text": "塞錢了事",
        "condition": {
          "min_stats": {
            "silver": 20
          }
        },
        "effect": {
          "text": "一串錢遞過去，柵門就開了。身後的行商看著你，眼神說不清是羨慕還是鄙夷。",
          "stats": {
            "silver": -20
          }
        }
      }
    ],
    "free_text": {
      "prompt": "自己想辦法脫出哨卡",
      "stat": "wis",
      "by": "team",
      "effect": {
        "text": "戍卒最後揮揮手放你上路，草棚裡的行商看你的眼神都帶了幾分佩服。",
        "stats": {
          "fame": 1
        }
      },
      "fail_effect": {
        "text": "戍卒起了疑心，把你看得更緊，最後還是得掏錢才走得了。",
        "stats": {
          "silver": -15
        }
      }
    }
  },
  {
