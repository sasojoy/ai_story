      "socialize"
    ],
    "locations": [
      "wan_city"
    ],
    "condition": {
      "flags_none": [
        "結識:sunjian"
      ]
    },
    "text": "城中傳聞，佐軍司馬孫堅在南陽一帶連戰連捷，人稱「江東猛虎」。你在校場外見到他時，他正赤手空拳跟幾個部曲較力，笑聲豪邁。",
    "choices": [
      {
        "text": "上前結交",
        "effect": {
          "text": "孫堅爽朗一笑，重重握住你的手：「痛快！少俠往後儘管來尋我！」",
          "flags_add": [
            "結識:sunjian"
          ]
        }
      },
      {
        "text": "只是遠遠看著",
        "effect": {
          "text": "孫堅的笑聲在校場上回蕩，你沒有上前。"
        }
      }
    ]
  },
  {
