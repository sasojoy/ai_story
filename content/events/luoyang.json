        "fail_effect": {
          "text": "你踩落了一塊石頭，盜墓的人聽見動靜，熄了燈跑了。"
        }
      },
      {
        "text": "要他們分你一份",
        "effect": {
          "text": "他們塞給你一個陶罐要你閉嘴。你拿到城裡，換了些錢。",
          "stats": {
            "silver": 25,
            "evil": 3
          }
        }
      }
    ]
