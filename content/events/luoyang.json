[
  {
    "id": "luoyang_palace_whispers",
    "title": "宮門傳言",
    "locations": [
      "luoyang_palace"
    ],
    "text": "宮門外的槐樹下聚著幾個小吏，壓低了聲音說宮裡又有詔書下來。一個說是要調兵，一個說是要赦免黨人，爭得面紅耳赤。",
    "choices": [
      {
        "text": "湊過去細聽",
        "check": {
          "stat": "wis",
          "difficulty": 6
        },
        "effect": {
          "text": "你從他們的話裡理出了頭緒，轉頭說給城南的商隊聽，換了一頓飯錢。",
          "stats": {
            "silver": 15
          }
        },
        "fail_effect": {
          "text": "小吏們發覺你在偷聽，一下子散了，還回頭罵你是哪家派來的耳目。",
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "插嘴說潁川的黃巾已經逼近",
        "effect": {
          "text": "小吏們臉色發白，匆匆散去。不到半日，城裡就傳得滿街都是。",
          "stats": {
            "evil": 1
          }
        }
      },
      {
        "text": "走開",
        "effect": {
          "text": "宮門的衛士朝這邊看了一眼，小吏們也各自散了。"
        }
      }
    ]
  },
  {
    "id": "luoyang_palace_broker",
    "title": "宮中門路",
    "locations": [
      "luoyang_palace"
    ],
    "text": "一個穿綢衣的門客攔住你，說他家主人在宮中當差，只要奉上些許「心意」，便能替你在郎官的名冊上添個名字。",
    "choices": [
      {
        "text": "奉上銀子",
        "condition": {
          "min_stats": {
            "silver": 30
          }
        },
        "effect": {
          "text": "門客收了錢，要你回去等消息。幾天後街上果然有人喊你一聲「郎君」，除此之外，什麼也沒有。",
          "stats": {
            "silver": -30,
            "fame": 1,
            "evil": 1
          }
        }
      },
      {
        "text": "當眾問他主人姓甚名誰",
        "check": {
          "stat": "wis",
          "difficulty": 7
        },
        "effect": {
          "text": "你一句句追問，他答得前言不搭後語。圍觀的人都笑了，門客灰溜溜地走了。",
          "stats": {
            "good": 1,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "門客臉一沉，喚來兩個宮門衛士，把你趕到了街口。",
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "婉拒",
        "effect": {
          "text": "門客撇撇嘴，又去攔下一個人。"
        }
      }
    ]
  },
  {
    "id": "luoyang_fu_petition",
    "title": "府前請命",
    "locations": [
      "dajiangjun_fu"
    ],
    "text": "大將軍府門前跪著一群從潁川逃來的鄉紳，捧著血書請朝廷發兵。門吏不耐煩地驅趕，說大將軍正在議事，誰也不見。",
    "choices": [
      {
        "text": "想辦法把血書遞進府裡",
        "check": {
          "stat": "wis",
          "difficulty": 7
        },
        "effect": {
          "text": "你找到一個肯收錢辦事的府吏，把血書夾進了今天的奏報裡。鄉紳們向你千恩萬謝。",
          "stats": {
            "good": 2,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "門吏一把奪過血書，扔回了臺階下。"
        }
      },
      {
        "text": "幫門吏把他們趕走",
        "effect": {
          "text": "門吏賞了你幾個錢，鄉紳們在背後罵你是走狗。",
          "stats": {
            "silver": 10,
            "evil": 2
          }
        }
      },
      {
        "text": "給他們一些盤纏",
        "condition": {
          "min_stats": {
            "silver": 15
          }
        },
        "effect": {
          "text": "領頭的老鄉紳收下錢，說若能回到潁川，必定記得你。",
          "stats": {
            "silver": -15,
            "good": 2
          }
        }
      }
    ]
  },
  {
