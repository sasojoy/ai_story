        },
        "fail_effect": {
          "text": "第二碗還沒見底，你就扶著鼓架吐了一地，引得滿場哄笑。",
          "stamina": -10,
          "stats": {
            "fame": -1
          }
        }
      },
      {
        "text": "把那張硬弓拉滿",
        "check": {
          "stat": "str",
          "difficulty": 3
        },
        "effect": {
          "text": "弓弦勒得指節發白，你仍穩穩把弓拉成滿月。吏員點頭，賞了幾串錢。",
          "stats": {
            "silver": 10
          }
        },
        "fail_effect": {
          "text": "弓只拉開一半，弓梢一彈，險些打到自己的臉。",
          "stamina": -8
        }
      },
      {
        "text": "站在人群裡看熱鬧",
        "effect": {
          "text": "一個黑臉的少年把硬弓連拉三回，滿場喝彩。你記住了那張臉。"
        }
      }
    ]
  },
