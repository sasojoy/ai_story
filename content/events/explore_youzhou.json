[
  {
    "id": "yz_zhuo_recruit_wine",
    "title": "縣門募勇",
    "locations": [
      "zhuo_county"
    ],
    "text": "涿縣縣門外架起大鼓，縣吏奉命招募鄉勇赴冀州。案上擺著一罈烈酒和一張硬弓，吏員吆喝：連飲三大碗不倒、或拉滿那張硬弓的，賞錢入冊。",
    "choices": [
      {
        "text": "端起大碗，連飲三碗",
        "check": {
          "stat": "con",
          "difficulty": 5,
          "by": "self"
        },
        "effect": {
          "text": "三碗下肚，你面不改色地放下碗。圍觀的少年齊聲叫好，吏員把你的名號記上竹冊，另賞了錢。",
