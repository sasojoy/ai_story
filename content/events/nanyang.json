  {
    "id": "nanyang_xinye_lost_child",
    "title": "城牆下",
    "locations": [
      "xinye"
    ],
    "text": "低矮的城牆根下擠著逃難的人家。一個孩子拉住你的衣角，說他在宛城外跟爹娘走散了，不知道他們有沒有逃到這裡。",
    "choices": [
      {
        "text": "帶著他在逃難的人群裡四處打聽",
        "check": {
          "stat": "wis",
          "difficulty": 4
        },
        "effect": {
          "text": "問了一下午，總算在城東的破廟裡找到了他娘。孩子撲進娘懷裡，哭得說不出話。",
          "stats": {
            "good": 2,
            "fame": 1
          }
        },
        "fail_effect": {
          "text": "你們問遍了城裡，誰也沒見過那樣一對夫婦。孩子坐回了牆根下。"
        }
      },
      {
        "text": "買兩個餅給他",
        "condition": {
          "min_stats": {
            "silver": 5
          }
        },
        "effect": {
          "text": "孩子捧著餅，先掰了一半揣進懷裡，說要留給娘。",
          "stats": {
            "silver": -5,
            "good": 1
          }
        }
      },
      {
        "text": "甩開他的手",
        "effect": {
          "text": "孩子愣在原地，又去拉下一個人的衣角。",
          "stats": {
            "evil": 1
          }
        }
      }
    ]
  },
