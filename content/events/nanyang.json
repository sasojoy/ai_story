          }
        },
        "effect": {
          "text": "老者拉著你的袖子，嘴唇抖了半天，說不出一句話。",
          "stats": {
            "silver": -10,
            "good": 2
          }
        }
      },
      {
        "text": "一把撕下告示",
        "effect": {
          "text": "圍觀的人一陣叫好，差役追了你半條街。",
          "stamina": -10,
          "stats": {
            "fame": 1
          }
        }
      }
    ]
