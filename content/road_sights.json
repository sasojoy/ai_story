[
  {"id": "sight_refugee_bread", "text": "路邊坐著一家逃難的人，老人把最後半塊餅掰給孫子，自己舔了舔手指。你默默記下這一幕。", "roads": [], "regions": [], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_beacon_smoke", "text": "遠處山頭升起一道狼煙，筆直地插進天裡。不知又是哪座城告急。", "roads": [], "regions": [], "effect": {"stats": {"xinde": 1}}},
  {"id": "sight_post_rider", "text": "一名驛卒策馬從你身邊衝過，背上的羽檄插著三根雞毛。路邊的人搖頭說，驛路上的羽檄一天比一天多，前線怕是吃緊了。", "roads": [], "regions": [], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_yellow_scarf", "text": "路旁的樹枝上纏著一條褪了色的黃巾，風一吹，像一面小旗。", "roads": [], "regions": [], "effect": {"stats": {"xinde": 1}}},
  {"id": "sight_rut_coins", "text": "車轍裡有幾枚被泥糊住的五銖錢，大概是哪輛糧車顛下來的。", "roads": [], "regions": [], "effect": {"stats": {"silver": 6}}},
  {"id": "sight_one_armed_veteran", "text": "一個斷了左臂的老兵坐在路邊磨刀，見你經過，只說了一句：「打仗，先學怎麼活著回來。」", "roads": [], "regions": [], "effect": {"stats": {"xinde": 3}}},
  {"id": "sight_grain_convoy", "text": "一長串糧車往前線去，押車的兵卒個個面黃肌瘦。一個兵小聲說，前線的糧只夠吃半個月。", "roads": ["官道"], "regions": [], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_milestone_carving", "text": "道旁的里程石被人用刀刻了兩個字：「黃天」。旁邊又被人用力劃掉。", "roads": ["官道"], "regions": [], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_road_checkpoint", "text": "亭長在路口設了卡，挨個盤問往來的人。輪到你時，他看了一眼，揮手放行。", "roads": ["官道"], "regions": [], "effect": {"stats": {"xinde": 1}}},
  {"id": "sight_empty_village_well", "text": "路過一個空村，井邊的轆轤還在轉，人卻不知去了哪裡。井沿上壓著一塊沉甸甸的圓石。", "roads": ["路"], "regions": [], "effect": {"materials": {"man_1": 1}}},
  {"id": "sight_peddler_willow", "text": "挑擔的貨郎跟你同走了一段，一路說個不停，臨別送你一小束柳絲，說是自家婆娘紡的。", "roads": ["路"], "regions": [], "effect": {"materials": {"rou_1": 1}}},
  {"id": "sight_hawk_feather", "text": "山道上一聲鷹唳，一根灰白的尾羽打著旋落在你腳邊。", "roads": ["山路"], "regions": [], "effect": {"materials": {"kuai_1": 1}}},
  {"id": "sight_hunter_snare", "text": "路邊有獵戶設的套索，套住的山雞早被什麼東西叼走了，只剩一地毛。你學會了那個結的打法。", "roads": ["山路"], "regions": [], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_mountain_fog", "text": "山腰起了霧，你在霧裡摸索了半個時辰，出來時衣襟全濕了。", "roads": ["山路"], "regions": [], "effect": {"stats": {"xinde": 1}}},
  {"id": "sight_northern_horses", "text": "北地的牧人趕著一群馬南下，說涿郡那邊有人在招兵買馬，出手很大方。", "roads": [], "regions": ["youzhou"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_hot_wine_stall", "text": "北風刮得臉生疼，路邊酒棚賣熱酒，一碗下肚，整個人都活了過來。", "roads": [], "regions": ["youzhou"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_talisman_wall", "text": "村口的土牆上貼滿了黃紙符，有的被雨水泡爛了，有的還很新。", "roads": [], "regions": ["jizhou"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_untended_fields", "text": "田裡長滿了野草，該收的麥子沒人收。路邊的老農說，壯丁都被拉進了營裡。", "roads": [], "regions": ["jizhou"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_eunuch_carriage", "text": "一輛華蓋馬車駛過，車簾後的人面白無鬚，冷冷瞥了你一眼。茶棚裡的人等車走遠了才說，宮裡的常侍們這陣子收錢收得更兇了。", "roads": [], "regions": ["luoyang"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_imperial_students", "text": "幾個太學生邊走邊爭論朝政，聲音一大，又四下張望，趕緊壓低。", "roads": [], "regions": ["luoyang"], "effect": {"stats": {"xinde": 3}}},
  {"id": "sight_jiazi_ruins", "text": "一座燒過的亭舍還冒著餘煙，牆上用白土寫著「甲子」兩個大字。", "roads": [], "regions": ["yingru"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_crowded_ferry", "text": "潁水的渡船擠滿了人，你幫船家撐了一段篙，他把船錢退給你。", "roads": [], "regions": ["yingru"], "effect": {"stats": {"silver": 5}}},
  {"id": "sight_fortune_teller", "text": "一個汝南來的讀書人在樹下歇腳，硬要替你算一卦，說你命裡有貴人，卦錢卻不肯收。", "roads": [], "regions": ["yingru"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_drifting_boat", "text": "河上漂下來一隻空船，艙裡只剩半袋米和一把斷槳。你在船板縫裡摳出幾枚錢。", "roads": [], "regions": ["nanyang"], "effect": {"stats": {"silver": 7}}},
  {"id": "sight_wan_walls", "text": "遠遠望見宛城的城牆，牆根下歇腳的人說，城頭的旗子換來換去，誰也記不清了。", "roads": [], "regions": ["nanyang"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_standoff_ditch", "text": "兩撥人馬在官道上隔著一條溝對望了一陣，誰也沒動手，各自走開了。", "roads": ["官道"], "regions": ["jizhou"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_palace_skyline", "text": "翻過南面的山嶺，洛陽的宮闕忽然出現在眼前，屋脊在日頭下亮得刺眼。", "roads": ["山路"], "regions": ["luoyang"], "effect": {"stats": {"xinde": 2}}},
  {"id": "sight_hoofprints", "text": "北邊的山路上滿是新鮮的馬蹄印，你繞了個遠路，躲開了那群人。", "roads": ["山路"], "regions": ["youzhou"], "effect": {"stats": {"xinde": 1}}},
  {"id": "sight_merchant_caravan", "text": "商旅結伴而行，十幾輛車首尾相接，誰也不敢落單。你替他們探了一段路，領隊塞給你幾枚錢。", "roads": ["官道"], "regions": ["yingru"], "effect": {"stats": {"silver": 8}}},
  {"id": "sight_herb_doctor", "text": "一個老醫蹲在溝邊採草，說這草能止血，分了你一把，教你認了葉子。", "roads": ["路"], "regions": ["nanyang"], "effect": {"stats": {"xinde": 2}}}
]
